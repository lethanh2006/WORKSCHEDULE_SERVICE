PORT=5004
MONGO_URL=mongodb://localhost:27017/nrapp
USER_SERVICE_URL=http://localhost:5000
# Dùng cùng giá trị USER_INTERNAL_SECRET của User Service (tối thiểu 32 byte).
USER_INTERNAL_SECRET=
WORKSCHEDULE_INTERNAL_SECRET=
WORKSCHEDULE_SIGNATURE_MAX_AGE_MS=300000

# Structured log + OpenTelemetry (local development)
LOG_LEVEL=debug
LOG_FORMAT=pretty
OTEL_SERVICE_NAME=workschedule
OTEL_SERVICE_VERSION=development
DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRIC_EXPORT_INTERVAL=15000
